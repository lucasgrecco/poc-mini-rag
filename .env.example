# Copy to .env and fill in the values. .env is git-ignored and never committed.

# Required for CLI search (embeddings + chat). Leave empty to fall back to the
# local embedding model; the MCP server never needs it.
OPENAI_API_KEY=

# Optional: LangSmith tracing.
LANGSMITH_TRACING=
LANGSMITH_ENDPOINT=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=

# Optional overrides — leave commented out to use the defaults shown.
# An empty value here is NOT the same as unset: it overrides the default.
#CARD_JSON_DIR=jsons
#DATABASE_URL=postgresql+psycopg2://admin:admin@db/rag_db
